#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
set -e

# The oldest amd64 build targets x86-64-v2. Without these flags the binaries stop with SIGILL.
required_x86_flags="cx16 lahf_lm pni popcnt sse4_1 sse4_2 ssse3"

case "$1" in
install|upgrade)
    if [ "$(dpkg --print-architecture)" = amd64 ] && [ -r /proc/cpuinfo ]; then
        flags=" $(grep -m1 '^flags' /proc/cpuinfo | cut -d: -f2) "
        missing=
        for flag in $required_x86_flags; do
            case "$flags" in
            *" $flag "*) ;;
            *) missing="$missing $flag" ;;
            esac
        done
        if [ -n "$missing" ]; then
            echo "umts-hnb requires an x86-64-v2 CPU (Intel Nehalem, AMD Bulldozer or later)." >&2
            echo "This CPU is missing:$missing" >&2
            exit 1
        fi
    fi
    ;;
esac

#DEBHELPER#

exit 0
